#!/usr/bin/env python3
"""
clusterMD: multidimensional HDBSCAN clustering and structural analysis
of PCA/dPCA coordinates derived from molecular-dynamics trajectories.

Executes the complete clustering, observed-label-change, visualization, and structural-extraction sequence.
"""

import os
import sys
import glob
import time
import datetime
import argparse
import subprocess
import warnings
import psutil
import logging
import math
import shutil
import tempfile
import numpy as np
import scipy
import re
import shlex

# =========================================================================
# GLOBAL CONSTANTS & PHYSICAL PARAMETERS
# =========================================================================
R_KCAL = 0.0019872041                # Ideal gas constant in kcal/(mol*K)
MAX_FREE_ENERGY_KCAL = 9.0           # Cap for free-energy surface plots (kcal/mol)
FALLBACK_ATOM_FLAGS = ["-atomid", "CA", "-atomid", "C", "-atomid", "N", "-atomid", "O"]
ANSI_ESCAPE = re.compile(r'\x1b\[[0-9;]*m')

class Colors:
    LIGHT_BLUE = '\033[96m'   # Processing / Info steps
    BLUE = '\033[94m'         # Success / Milestones
    YELLOW = '\033[93m'       # Warnings
    RED = '\033[91m'          # Errors
    BOLD = '\033[1m'
    RESET = '\033[0m'

class PlainFileFormatter(logging.Formatter):
    """Strips ANSI color codes for clean file logging."""
    def format(self, record):
        message = super().format(record)
        return ANSI_ESCAPE.sub('', message)

def get_clusterMD_file_handler():
    """Safely retrieves the designated file handler by name."""
    for handler in logging.getLogger().handlers:
        if getattr(handler, "name", None) == "clusterMD_file":
            return handler
    return None

class PlotStyle:
    """Centralized formatting standard for all scientific figures."""
    FIG_SIZE = (10, 8)
    DPI = 600
    # Absolute margins guarantee the internal axes rect is pixel-identical across all 2D plots
    MARGINS = {'left': 0.12, 'right': 0.80, 'bottom': 0.12, 'top': 0.88}
    CBAR_AXES = [0.82, 0.12, 0.03, 0.76] 
    LEGEND_BBOX = (1.02, 0.5)

    CMAP_SCATTER = 'turbo'
    CMAP_FES = 'turbo_r'
    
    NOISE_COLOR = 'lightgrey'
    NOISE_SIZE = 0.5
    NOISE_ALPHA = 0.5
    CLUSTER_SIZE = 1.0
    CLUSTER_ALPHA = 0.8
    
    TITLE_FMT = {'fontsize': 16, 'fontweight': 'bold', 'pad': 15}
    LABEL_FMT = {'fontsize': 14, 'fontweight': 'bold'}
    TICK_SIZE = 12

    @staticmethod
    def apply_standard_layout(fig, ax, title, xlabel, ylabel, xlim=None, ylim=None):
        fig.subplots_adjust(**PlotStyle.MARGINS)
        ax.set_title(title, **PlotStyle.TITLE_FMT)
        ax.set_xlabel(xlabel, **PlotStyle.LABEL_FMT)
        ax.set_ylabel(ylabel, **PlotStyle.LABEL_FMT)
        if xlim: ax.set_xlim(xlim)
        if ylim: ax.set_ylim(ylim)
        ax.tick_params(labelsize=PlotStyle.TICK_SIZE)

    @staticmethod
    def get_cluster_colors(unique_clusters, cmap_name):
        import matplotlib.pyplot as plt
        cmap = plt.get_cmap(cmap_name)
        n_clusters = len(unique_clusters)
        return {cid: cmap(i / max(1, n_clusters - 1)) for i, cid in enumerate(unique_clusters)}

    @staticmethod
    def repel_labels(node_positions, xlim, ylim):
        """Deterministic spring-repel algorithm to prevent label overlap."""
        labels_pos = {k: np.array(v, dtype=float) for k, v in node_positions.items()}
        x_range = xlim[1] - xlim[0]
        y_range = ylim[1] - ylim[0]
        min_dist_x = x_range * 0.05
        min_dist_y = y_range * 0.05
        
        for _ in range(150):
            moved = False
            forces = {k: np.zeros(2) for k in labels_pos}
            for k1, p1 in labels_pos.items():
                forces[k1] += (node_positions[k1] - p1) * 0.1  # Spring to origin
                for k2, p2 in labels_pos.items():
                    if k1 == k2: continue
                    dx = p1[0] - p2[0]
                    dy = p1[1] - p2[1]
                    dist_x = abs(dx)
                    dist_y = abs(dy)
                    if dist_x < min_dist_x and dist_y < min_dist_y:
                        tie_sign = -1.0 if k1 < k2 else 1.0
                        repel_x = (
                            (min_dist_x - dist_x) * np.sign(dx)
                            if dx != 0
                            else (min_dist_x - dist_x) * tie_sign
                        )
                        repel_y = (
                            (min_dist_y - dist_y) * np.sign(dy)
                            if dy != 0
                            else (min_dist_y - dist_y) * tie_sign
                        )
                        forces[k1] += np.array([repel_x, repel_y]) * 0.3
                        moved = True
            for k in labels_pos:
                labels_pos[k] += forces[k]
            if not moved:
                break
        return labels_pos


# =========================================================================
# 1. FORMATTING & ENV UTILITIES
# =========================================================================
def format_duration(seconds):
    """Converts raw seconds into a human-readable time format."""
    m, s = divmod(int(seconds), 60)
    h, m = divmod(m, 60)
    if h > 0: return f"{h}h {m}m {s}s"
    elif m > 0: return f"{m}m {s}s"
    else: return f"{seconds:.2f}s"

def format_record(raw_line, frame_val, cid_val):
    """Parses a raw data line and aligns it into a clean, readable column format."""
    coords_str = " ".join([f"{c:9.5f}" for c in raw_line])
    return f"Frame {frame_val:7d} | Cluster {cid_val:4d} | Coordinates: {coords_str}"

def get_software_env():
    """Detects software and library versions for the provenance report."""
    try:
        import importlib.metadata
        fh_ver = importlib.metadata.version('fast_hdbscan')
    except Exception:
        try:
            import fast_hdbscan
            fh_ver = fast_hdbscan.__version__ if hasattr(fast_hdbscan, '__version__') else "not detected"
        except ImportError:
            fh_ver = "not found"
            
    carma_path = shutil.which("carma")
    carma_ver = "not detected"
    if carma_path:
        try:
            res = subprocess.run(["carma"], capture_output=True, text=True)
            for line in (res.stderr + "\n" + res.stdout).splitlines():
                if "version" in line.lower() or " v." in line.lower() or "carma v" in line.lower():
                    match = re.search(r'v\.?\s*(\d+\.\d+)', line.lower())
                    if match:
                        carma_ver = match.group(1)
                    else:
                        parts = line.strip().split()
                        carma_ver = parts[1] if len(parts) > 1 else line.strip()
                    break
        except Exception:
            pass
            
    return {
        "clusterMD_ver": "1.1.0",
        "python_ver": sys.version.split()[0],
        "numpy_ver": np.__version__,
        "scipy_ver": scipy.__version__,
        "fh_ver": fh_ver,
        "carma_path": carma_path if carma_path else "NOT FOUND",
        "carma_ver": carma_ver
    }


# =========================================================================
# 2. LOADING (Memory-Efficient I/O)
# =========================================================================
def ingest_trajectory_data(file_path, step=1):
    """Loads and validates a strided projection dataset using preallocated memory."""
    if os.path.getsize(file_path) == 0:
        logging.error(f"{Colors.RED}[-]{Colors.RESET} Critical error: Coordinate file is empty.")
        sys.exit(1)

    logging.info(f"{Colors.LIGHT_BLUE}[*]{Colors.RESET} Pre-allocating memory and loading data (Stride: {step})...")
    
    try:
        out = subprocess.check_output(['wc', '-l', file_path])
        total_lines = int(out.split()[0])
    except (subprocess.CalledProcessError, FileNotFoundError):
        with open(file_path, 'r') as f:
            total_lines = sum(1 for _ in f)
            
    parse_stats = {
        'total_lines': total_lines,
        'selected_by_stride': 0,
        'valid_sampled': 0,
        'malformed_sampled': 0,
        'first_sampled_frame': None,
        'last_sampled_frame': None,
        'sampled_monotonic': True,
        'sampled_duplicates': False
    }
            
    from collections import Counter
    col_counts = []
    with open(file_path, 'r') as f:
        for i, line in enumerate(f):
            if i >= 500:
                break
            parts = line.split()
            if parts:
                col_counts.append(len(parts))
                
    if not col_counts:
        logging.error(f"{Colors.RED}[-]{Colors.RESET} Critical error: Coordinate file contains no parseable data.")
        sys.exit(1)
        
    num_cols = Counter(col_counts).most_common(1)[0][0]
            
    subset_size = math.ceil(total_lines / step)
    data = np.zeros((subset_size, num_cols))
    
    last_frame_val = None
    seen_frames = set()
    
    with open(file_path, 'r') as f:
        idx = 0
        for i, line in enumerate(f):
            if i % step == 0:
                parse_stats['selected_by_stride'] += 1
                parts = line.split()
                if parts:
                    if len(parts) == num_cols:
                        try:
                            frame_val = float(parts[0])
                            if not frame_val.is_integer() or frame_val <= 0:
                                logging.error(f"{Colors.RED}[-]{Colors.RESET} Critical error: Frame IDs must be positive integers. Found '{parts[0]}' at line {i+1}.")
                                sys.exit(1)
                            
                            frame_int = int(frame_val)
                            if parse_stats['first_sampled_frame'] is None:
                                parse_stats['first_sampled_frame'] = frame_int
                            parse_stats['last_sampled_frame'] = frame_int
                            
                            if last_frame_val is not None and frame_int <= last_frame_val:
                                parse_stats['sampled_monotonic'] = False
                            if frame_int in seen_frames:
                                parse_stats['sampled_duplicates'] = True
                                
                            seen_frames.add(frame_int)
                            last_frame_val = frame_int
                            
                            row_vals = [float(x) for x in parts]
                            if not all(math.isfinite(x) for x in row_vals):
                                logging.error(f"{Colors.RED}[-]{Colors.RESET} Critical error: Non-finite value (NaN/Inf) detected at line {i+1}. Analysis aborted.")
                                sys.exit(1)
                                
                            data[idx] = row_vals
                            idx += 1
                            parse_stats['valid_sampled'] += 1
                        except ValueError:
                            parse_stats['malformed_sampled'] += 1
                            logging.warning(f"{Colors.YELLOW}[WARN]{Colors.RESET} Format anomaly at line {i+1}: non-numeric data. Row skipped.")
                    else:
                        parse_stats['malformed_sampled'] += 1
                        logging.warning(f"{Colors.YELLOW}[WARN]{Colors.RESET} Format anomaly at line {i+1}: expected {num_cols} cols, found {len(parts)}. Frame skipped.")
                        
    return data[:idx], parse_stats


# =========================================================================
# 3. CLUSTERING (HDBSCAN Engine & Sorting)
# =========================================================================
def execute_clustering_algorithm(data_nd, size, samples, method):
    """Executes the core HDBSCAN clustering algorithm."""
    import fast_hdbscan
    t0 = time.time()
    clusterer = fast_hdbscan.HDBSCAN(min_cluster_size=size, min_samples=samples, cluster_selection_method=method)
    labels = clusterer.fit_predict(data_nd)
    runtime = time.time() - t0
    return labels, runtime

def sort_cluster_populations(labels):
    """Sorts cluster assignments by descending population size."""
    unique_clusters = np.unique(labels[labels != -1])
    cluster_counts = {cid: np.sum(labels == cid) for cid in unique_clusters}
    sorted_old_cids = sorted(cluster_counts, key=cluster_counts.get, reverse=True)
    
    id_mapping = {-1: -1}
    for new_id, old_id in enumerate(sorted_old_cids): id_mapping[old_id] = new_id
    
    reordered_labels = np.copy(labels)
    for old_id, new_id in id_mapping.items():
        if old_id != -1: reordered_labels[labels == old_id] = new_id
        
    return reordered_labels, np.unique(reordered_labels[reordered_labels != -1])

def export_cluster_coordinates(frames, labels, data_nd, out_file, n_dimensions):
    """Exports the assigned coordinate matrices to a .dat file."""
    out_data = np.column_stack((frames, labels, data_nd))
    fmt_string = f"%10d %4d " + ' '.join(['%11.7f'] * n_dimensions)
    np.savetxt(out_file, out_data, fmt=fmt_string)


# =========================================================================
# 4. POPULATIONS, FREE-ENERGY ESTIMATES & OBSERVED LABEL CHANGES
# =========================================================================
def calculate_populations_and_energies(labels, temp):
    """Computes assigned-cluster populations and population-derived relative free-energy estimates."""
    valid_mask = labels != -1
    valid_labels = labels[valid_mask]
    states, counts = np.unique(valid_labels, return_counts=True)
    population_map = {state: count for state, count in zip(states, counts)}
    
    k_B_T = R_KCAL * temp
    max_count = np.max(counts) if len(counts) > 0 else 1
    free_energies = {state: -k_B_T * np.log(count / max_count) for state, count in zip(states, counts)}
    
    return states, counts, population_map, free_energies, k_B_T

def map_observed_label_changes(labels):
    """Counts undirected changes between consecutive assigned labels after omitting unassigned/noise configurations."""
    valid_labels = labels[labels != -1]
    label_changes = {}         
    for i in range(len(valid_labels) - 1):
        sA, sB = valid_labels[i], valid_labels[i+1]
        if sA != sB:
            edge = tuple(sorted([sA, sB]))
            label_changes[edge] = label_changes.get(edge, 0) + 1
    return label_changes

def print_top_observed_changes(label_changes, top_n):
    """Outputs the most frequent observed changes between assigned cluster labels."""
    sorted_changes = sorted(label_changes.items(), key=lambda item: item[1], reverse=True)
    
    logging.info("\n    OBSERVED LABEL CHANGES")
    logging.info("    " + "-"*49)
    logging.info(f"    {'Cluster pair':<32}{'Observed changes':>17}")
    logging.info("    " + "-"*49)
    
    for edge, count in sorted_changes[:top_n]:
        pair_str = f"{edge[0]} <--> {edge[1]}"
        logging.info(f"    {pair_str:<32}{count:>17d}")
        
    logging.info("    " + "-"*49)
    logging.info(f"    {'Unique cluster pairs':<32}{len(label_changes):>17d}")
    
    return sorted_changes

def hunt_chronological_label_changes(target_edge, labels, frames, data_nd, max_events):
    """Inspects the chronology of observed changes between assigned cluster labels."""
    logging.info(f"\n{Colors.LIGHT_BLUE}[*]{Colors.RESET} Inspecting chronological change events for cluster pair {target_edge}...")
    events_found = 0
    last_valid_state, last_valid_idx = None, None
    intervening_noise_indices = []
    
    for idx, label in enumerate(labels):
        if label != -1:
            if last_valid_state is not None and last_valid_state != label:
                current_edge = tuple(sorted([last_valid_state, label]))
                if current_edge == target_edge:
                    events_found += 1
                    if events_found <= max_events:
                        logging.info(f"\n{Colors.LIGHT_BLUE}--- Observed Change Event {events_found} ---{Colors.RESET}")
                        logging.info(f"PREVIOUS ASSIGNED : {format_record(data_nd[last_valid_idx], frames[last_valid_idx], last_valid_state)}")
                        if intervening_noise_indices:
                            logging.info(f"  ... [ {len(intervening_noise_indices)} intervening unassigned/noise frames (-1) ] ...")
                            for f_idx in intervening_noise_indices[:2]: logging.info(f"  UNASSIGNED: {format_record(data_nd[f_idx], frames[f_idx], -1)}")
                            if len(intervening_noise_indices) > 2: logging.info("  ...      (additional unassigned/noise frames hidden to save space)")
                        logging.info(f"NEXT ASSIGNED     : {format_record(data_nd[idx], frames[idx], label)}")
            last_valid_state, last_valid_idx = label, idx
            intervening_noise_indices = []
        else:
            if last_valid_state is not None: intervening_noise_indices.append(idx)
            
    if events_found == 0:
        logging.error(f"{Colors.YELLOW}[WARN]{Colors.RESET} No observed label changes found between Cluster {target_edge[0]} and Cluster {target_edge[1]}.")
    elif events_found > max_events:
        logging.info(f"\n{Colors.BLUE}[+]{Colors.RESET} ... and {events_found - max_events} additional events hidden.")
    logging.info("="*85 + "\n")


# =========================================================================
# 5. VISUALIZATION
# =========================================================================
def render_conformational_landscape(x, y, lx, ly, p1, p2, unique_clusters, labels, zero_var, out_prefix):
    import matplotlib.pyplot as plt
    fig, ax = plt.subplots(figsize=PlotStyle.FIG_SIZE, dpi=PlotStyle.DPI) 
    
    if np.any(labels == -1):
        ax.scatter(x[labels == -1], y[labels == -1], color=PlotStyle.NOISE_COLOR, s=PlotStyle.NOISE_SIZE, alpha=PlotStyle.NOISE_ALPHA, label='Unassigned / noise')
        
    colors = PlotStyle.get_cluster_colors(unique_clusters, PlotStyle.CMAP_SCATTER)
    for cid in unique_clusters:
        mask = (labels == cid)
        ax.scatter(x[mask], y[mask], color=colors[cid], s=PlotStyle.CLUSTER_SIZE, alpha=PlotStyle.CLUSTER_ALPHA, label=f'Cluster {cid}')
        
    PlotStyle.apply_standard_layout(fig, ax, "Conformational Projection", f"Principal Component {p1}", f"Principal Component {p2}", lx, ly)
    
    if zero_var:
        ax.text(0.5, 0.5, "Zero-variance projection\n(coincident configurations)", transform=ax.transAxes, ha='center', va='center', fontsize=14, fontweight='bold', color='gray', alpha=0.7)
    elif len(unique_clusters) <= 35: 
        ax.legend(markerscale=5, loc='center left', bbox_to_anchor=PlotStyle.LEGEND_BBOX, framealpha=0.8)
        
    fig.savefig(f"{out_prefix}.png", dpi=PlotStyle.DPI)
    plt.close(fig)

def render_fes_connectivity(pc1, pc2, unique_clusters, labels, k_B_T, xl12, yl12, label_changes, top_edges, out_file):
    import matplotlib.pyplot as plt
    
    hist, xedges, yedges = np.histogram2d(pc1, pc2, bins=150, range=[xl12, yl12])
    hist = hist.T  # Explicit transposition for correct Cartesian rendering
    
    free_energy = -k_B_T * np.log((hist + 1e-10) / np.max(hist))
    free_energy[free_energy > MAX_FREE_ENERGY_KCAL] = MAX_FREE_ENERGY_KCAL 
    
    X, Y = np.meshgrid((xedges[:-1] + xedges[1:]) / 2, (yedges[:-1] + yedges[1:]) / 2)
    
    fig, ax = plt.subplots(figsize=PlotStyle.FIG_SIZE, dpi=PlotStyle.DPI)
    contour = ax.contourf(X, Y, free_energy, levels=np.linspace(0, MAX_FREE_ENERGY_KCAL, 16), cmap=PlotStyle.CMAP_FES, extend='max')
    ax.contour(X, Y, free_energy, levels=np.linspace(0, MAX_FREE_ENERGY_KCAL, 16), colors='black', alpha=0.1, linewidths=0.5)
    
    node_positions = {}
    for cid in unique_clusters:
        mask = (labels == cid)
        node_positions[cid] = (np.median(pc1[mask]), np.median(pc2[mask]))

    if top_edges:
        max_w = max([label_changes[e] for e in top_edges]) if top_edges else 1
        # Reverse drawing order ensures highest-count (thickest) edges are rendered on top
        for edge in reversed(top_edges):
            sA, sB = edge
            if sA in node_positions and sB in node_positions:
                w = (label_changes[edge] / max_w) * 4.0 + 0.5
                ax.plot([node_positions[sA][0], node_positions[sB][0]], [node_positions[sA][1], node_positions[sB][1]], color='black', alpha=0.6, linewidth=w, zorder=2)
                
    labels_pos = PlotStyle.repel_labels(node_positions, xl12, yl12)
    for cid in unique_clusters:
        nx, ny = node_positions[cid]
        lx, ly = labels_pos[cid]
        if np.linalg.norm(np.array([nx, ny]) - np.array([lx, ly])) > 1e-3:
            ax.plot([nx, lx], [ny, ly], color='black', linewidth=0.5, zorder=3)
        ax.scatter(nx, ny, color='black', s=10, zorder=3)
        ax.text(lx, ly, str(cid), fontsize=9, fontweight='bold', color='black', ha='center', va='center', bbox=dict(facecolor='white', alpha=0.8, edgecolor='black', boxstyle='circle,pad=0.2'), zorder=4)
        
    PlotStyle.apply_standard_layout(fig, ax, "Population-Derived Free-Energy Landscape\n& Observed Cluster Connectivity", "Principal Component 1", "Principal Component 2", xl12, yl12)
    
    cax = fig.add_axes(PlotStyle.CBAR_AXES)
    cbar = fig.colorbar(contour, cax=cax)
    cbar.set_label('Relative free energy (kcal/mol)', **PlotStyle.LABEL_FMT)
    
    if len(top_edges) > 0:
        ax.text(0.02, 0.98, f"{len(top_edges)} highest-count observed cluster-pair changes", transform=ax.transAxes, ha='left', va='top', fontsize=10, bbox=dict(facecolor='white', alpha=0.8, edgecolor='none'))
    
    fig.savefig(out_file, dpi=PlotStyle.DPI)
    plt.close(fig)

def render_pcoa_connectivity(num_states, data_nd, labels, states, population_map, label_changes, top_edges, out_file):
    import matplotlib.pyplot as plt
    from scipy.spatial.distance import squareform, pdist
    cluster_medians = np.array([np.median(data_nd[labels == state], axis=0) for state in states])
    D = squareform(pdist(cluster_medians, metric='euclidean'))
    H = np.eye(num_states) - np.ones((num_states, num_states)) / num_states
    evals, evecs = np.linalg.eigh(-0.5 * H.dot(D**2).dot(H))
    idx = np.argsort(evals)[::-1]; evals, evecs = evals[idx], evecs[:, idx]
    pcoa_coords = evecs[:, :2] * np.sqrt(np.maximum(evals[:2], 0))
    pos_pcoa = {state: (pcoa_coords[i, 0], pcoa_coords[i, 1]) for i, state in enumerate(states)}
    
    pad_x = max((np.max(pcoa_coords[:, 0]) - np.min(pcoa_coords[:, 0])) * 0.15, 0.1)
    pad_y = max((np.max(pcoa_coords[:, 1]) - np.min(pcoa_coords[:, 1])) * 0.15, 0.1)
    xlim = (np.min(pcoa_coords[:, 0]) - pad_x, np.max(pcoa_coords[:, 0]) + pad_x)
    ylim = (np.min(pcoa_coords[:, 1]) - pad_y, np.max(pcoa_coords[:, 1]) + pad_y * 1.5) # Asymmetric top pad
    
    fig, ax = plt.subplots(figsize=PlotStyle.FIG_SIZE, dpi=PlotStyle.DPI)
    
    if top_edges:
        max_w = max([label_changes[e] for e in top_edges]) if top_edges else 1
        for edge in reversed(top_edges):
            sA, sB = edge
            if sA in pos_pcoa and sB in pos_pcoa:
                w = (label_changes[edge] / max_w) * 4.0 + 0.5
                ax.plot([pos_pcoa[sA][0], pos_pcoa[sB][0]], [pos_pcoa[sA][1], pos_pcoa[sB][1]], color='black', alpha=0.6, linewidth=w, zorder=1)
                
    colors = PlotStyle.get_cluster_colors(states, PlotStyle.CMAP_SCATTER)
    labels_pos = PlotStyle.repel_labels(pos_pcoa, xlim, ylim)
    
    for state in states:
        cx, cy = pos_pcoa[state]
        lx, ly = labels_pos[state]
        node_size = float(np.log10(population_map[state]) ** 3.5) * 8
        ax.scatter(cx, cy, s=node_size, color=colors[state], edgecolors='white', linewidths=1.5, zorder=2)
        if np.linalg.norm(np.array([cx, cy]) - np.array([lx, ly])) > 1e-3:
            ax.plot([cx, lx], [cy, ly], color='black', linewidth=0.5, zorder=3)
        ax.text(lx, ly, str(state), color='black', fontweight='bold', fontsize=10, ha='center', va='center', bbox=dict(facecolor='white', alpha=0.6, edgecolor='none', pad=0.1, boxstyle='round'), zorder=4)
        
    PlotStyle.apply_standard_layout(fig, ax, "Principal-Coordinate Representation\nof Cluster Medians & Connectivity", "PCoA Dimension 1", "PCoA Dimension 2", xlim, ylim)
    
    if len(top_edges) > 0:
        ax.text(0.02, 0.98, f"{len(top_edges)} highest-count observed cluster-pair changes", transform=ax.transAxes, ha='left', va='top', fontsize=10, bbox=dict(facecolor='white', alpha=0.8, edgecolor='none'))
        
    fig.savefig(out_file, dpi=PlotStyle.DPI)
    plt.close(fig)


# =========================================================================
# 6. STRUCTURAL EXTRACTION (CARMA)
# =========================================================================
def parse_atom_extraction_flags(target_dir):
    """Parses original log to maintain extraction atom consistency."""
    log_files = glob.glob(os.path.join(target_dir, 'last_carma_run.log'))
    if not log_files: return FALLBACK_ATOM_FLAGS, "fallback default backbone selection"
    try:
        with open(log_files[0], 'r') as f:
            for line in f:
                if "atoms are declared in the PSF file" in line:
                    if "non-hydrogen" in line: return ["-atmid", "HEAVY"], "parsed from last_carma_run.log (heavy atoms)"
                    parts = line.split()
                    atoms_idx = parts.index("atoms")
                    atom_names = parts[1:atoms_idx]
                    flags = []
                    for atom in atom_names: flags.extend(["-atomid", atom])
                    return flags, "parsed from last_carma_run.log"
    except (FileNotFoundError, ValueError, IndexError) as e:
        logging.warning(f"{Colors.YELLOW}[WARN]{Colors.RESET} Error parsing atom IDs ({e}). Reverting to default backbone selection.")
    return FALLBACK_ATOM_FLAGS, "fallback default backbone selection (parsing failed)"

def execute_carma_sandbox(cmd_list, run_dir='.'):
    """Runs carma in an isolated working directory and records its output in the execution log."""
    result = subprocess.run(cmd_list, capture_output=True, text=True, cwd=run_dir)
    
    file_handler = get_clusterMD_file_handler()
    if file_handler:
        if result.stdout:
            for line in result.stdout.splitlines(): 
                clean_line = ANSI_ESCAPE.sub('', line)
                file_handler.stream.write(clean_line + "\n")
        if result.stderr:
            for line in result.stderr.splitlines(): 
                clean_line = ANSI_ESCAPE.sub('', line)
                file_handler.stream.write("carma ERROR: " + clean_line + "\n")
        
        if result.returncode != 0:
            file_handler.stream.write(f"carma execution returned non-zero exit code ({result.returncode}) for command: {' '.join(cmd_list)}\n")
        
        file_handler.flush()
        
    return result.stdout, result.stderr, result.returncode

def _process_single_cluster(cid, index, total_clusters, labels, frames, data_nd, abs_original_dcd, abs_original_psf, abs_results_dir, extraction_flags, args, carma_stats, cluster_rmsds, cluster_reps, cluster_struct_counts, fh):
    """Processes one cluster for structural extraction, alignment, filtering, and representative-frame recovery."""
    total_str = f"({index+1:4d}/{total_clusters:4d})"
    sys.stdout.write(f"\r    -> Cluster {cid:4d} {total_str} : Processing structural ensemble...        ")
    sys.stdout.flush()
    if fh:
        fh.stream.write(f"    -> Processing structural ensemble: Cluster {cid:4d}...\n")
        fh.flush()
    
    cluster_mask = (labels == cid)
    cluster_frames = frames[cluster_mask]
    cluster_coords = data_nd[cluster_mask]
    initial_frame_count = len(cluster_frames)
    cluster_struct_counts[cid] = initial_frame_count
    
    centroid = np.mean(cluster_coords, axis=0)
    distances = np.linalg.norm(cluster_coords - centroid, axis=1)
    nearest_centroid_idx = np.argmin(distances)
    nearest_centroid_frame = cluster_frames[nearest_centroid_idx]
    nearest_centroid_idx_carma = nearest_centroid_idx + 1  
    
    with tempfile.TemporaryDirectory(dir=abs_results_dir) as tmp_dir:
        temp_frames_dat = os.path.join(tmp_dir, "temp_frames.dat")
        np.savetxt(temp_frames_dat, cluster_frames, fmt='%d')
        
        t_sub = time.time()
        _, _, rc_sort = execute_carma_sandbox(["carma", "-v", "-sort", "temp_frames.dat", abs_original_dcd], run_dir=tmp_dir)
        carma_stats['sort'] += (time.time() - t_sub)
        
        temp_full_dcd = os.path.join(tmp_dir, "carma.reordered.dcd")
        if rc_sort == 0 and os.path.exists(os.path.join(tmp_dir, "carma.reordered.dcd")):
            os.rename(os.path.join(tmp_dir, "carma.reordered.dcd"), temp_full_dcd)
        else:
            sys.stdout.write(f"\r    -> Cluster {cid:4d} {total_str} : [FAILED] Trajectory slicing error.          \n")
            cluster_reps[cid] = "FAILED"
            return False
        
        if fh:
            fh.stream.write(f"      -> Phase 1: Aligning cluster ensemble to representative frame...\n")
        t_sub = time.time()
        _, _, rc_cov = execute_carma_sandbox(["carma", "-v", "-w", "-cov"] + extraction_flags + [temp_full_dcd, abs_original_psf], run_dir=tmp_dir)
        _, _, rc_fit = execute_carma_sandbox(["carma", "-v", "-w", "-fit", "-reference", str(nearest_centroid_idx_carma)] + extraction_flags + [temp_full_dcd, abs_original_psf], run_dir=tmp_dir)
        carma_stats['rmsd'] += (time.time() - t_sub)
        
        if rc_fit != 0:
            sys.stdout.write(f"\r    -> Cluster {cid:4d} {total_str} : [FAILED] Structural alignment error.        \n")
            cluster_reps[cid] = "FAILED"
            return False
            
        temp_fitted_dcd = os.path.join(tmp_dir, "carma.fitted.dcd")
        if os.path.exists(os.path.join(tmp_dir, "carma.fitted.dcd")):
            os.rename(os.path.join(tmp_dir, "carma.fitted.dcd"), temp_fitted_dcd)
        else:
            temp_fitted_dcd = temp_full_dcd 
        
        pseudo_psf = os.path.join(tmp_dir, "carma.selected_atoms.psf")
        safe_psf = os.path.join(tmp_dir, "cluster.psf")
        if os.path.exists(pseudo_psf):
            os.rename(pseudo_psf, safe_psf)
        else:
            safe_psf = abs_original_psf

        if fh:
            fh.stream.write(f"      -> Phase 2: Calculating mathematical average & superposition...\n")
        t_sub = time.time()
        _, _, rc_super = execute_carma_sandbox(["carma", "-v", "-cov", "-dot", "-super"] + extraction_flags + [temp_fitted_dcd, safe_psf], run_dir=tmp_dir)
        carma_stats['super'] += (time.time() - t_sub)
        
        if rc_super != 0 or not os.path.exists(os.path.join(tmp_dir, "carma.average.pdb")):
            sys.stdout.write(f"\r    -> Cluster {cid:4d} {total_str} : [FAILED] Superposition processing error.    \n")
            cluster_reps[cid] = "FAILED"
            return False
            
        super_pdb = os.path.join(tmp_dir, "carma.superposition.pdb")
        if os.path.exists(super_pdb):
            os.rename(super_pdb, os.path.join(abs_results_dir, f"cluster_{cid:04d}_superposition.pdb"))
        avg_pdb = os.path.join(tmp_dir, "carma.average.pdb")
        if os.path.exists(avg_pdb):
            os.rename(avg_pdb, os.path.join(abs_results_dir, f"cluster_{cid:04d}_average.pdb"))
        
        rms_average_dat = os.path.join(tmp_dir, "carma.rms-average.dat")
        cluster_rmsds[cid] = -1.0
        
        if os.path.exists(rms_average_dat):
            try:
                rmsd_data = np.loadtxt(rms_average_dat)
                if rmsd_data.ndim == 1:
                    rmsd_data = rmsd_data.reshape(-1, 2)
                rmsd_values = rmsd_data[:, 1]
                cluster_rmsds[cid] = float(np.max(rmsd_values))
                
                if args.rmsd > 0.0:
                    if fh:
                        fh.stream.write(f"      -> Phase 3: Applying RMSD-based structural filtering relative to the average structure (Threshold: {args.rmsd} A)...\n")
                        fh.flush()
                    core_mask = rmsd_values <= args.rmsd
                    retained_count = np.sum(core_mask)
                    
                    if retained_count > 0:
                        core_cluster_frames = cluster_frames[core_mask]
                        if fh:
                            fh.stream.write(f"      -> Filter applied successfully: Retained {retained_count}/{initial_frame_count} frames in the RMSD-filtered structural ensemble.\n")
                        sys.stdout.write(f"\r    -> Cluster {cid:4d} {total_str} : Retained {retained_count}/{initial_frame_count} frames after RMSD filtering.        \n")
                        cluster_struct_counts[cid] = int(retained_count)
                        
                        np.savetxt(temp_frames_dat, core_cluster_frames, fmt='%d')
                        t_sub = time.time()
                        _, _, rc_filter = execute_carma_sandbox(["carma", "-v", "-sort", "temp_frames.dat", abs_original_dcd], run_dir=tmp_dir)
                        carma_stats['sort'] += (time.time() - t_sub)
                        
                        if rc_filter == 0 and os.path.exists(os.path.join(tmp_dir, "carma.reordered.dcd")):
                            core_dcd_path = os.path.join(abs_results_dir, f"cluster_{cid:04d}_core.dcd")
                            os.rename(os.path.join(tmp_dir, "carma.reordered.dcd"), core_dcd_path)
                            
                            core_fitted = os.path.join(tmp_dir, "core_fitted.dcd")
                            _, _, rc_core_fit = execute_carma_sandbox(["carma", "-v", "-w", "-fit", "-reference", "1"] + extraction_flags + [core_dcd_path, abs_original_psf], run_dir=tmp_dir)
                            if rc_core_fit == 0 and os.path.exists(os.path.join(tmp_dir, "carma.fitted.dcd")):
                                os.rename(os.path.join(tmp_dir, "carma.fitted.dcd"), core_fitted)
                            else:
                                core_fitted = core_dcd_path
                                
                            execute_carma_sandbox(["carma", "-v", "-cov", "-dot", "-super"] + extraction_flags + [core_fitted, safe_psf], run_dir=tmp_dir)
                            
                            if os.path.exists(os.path.join(tmp_dir, "carma.superposition.pdb")):
                                os.rename(os.path.join(tmp_dir, "carma.superposition.pdb"), os.path.join(abs_results_dir, f"cluster_{cid:04d}_superposition.pdb"))
                            if os.path.exists(os.path.join(tmp_dir, "carma.average.pdb")):
                                os.rename(os.path.join(tmp_dir, "carma.average.pdb"), os.path.join(abs_results_dir, f"cluster_{cid:04d}_average.pdb"))
                                
                            rms_core_dat = os.path.join(tmp_dir, "carma.rms-average.dat")
                            if os.path.exists(rms_core_dat):
                                c_rmsd = np.loadtxt(rms_core_dat)
                                if c_rmsd.ndim == 1: c_rmsd = c_rmsd.reshape(-1, 2)
                                cluster_rmsds[cid] = float(np.max(c_rmsd[:, 1]))
                        
                        cluster_frames = core_cluster_frames
                    else:
                        sys.stdout.write(f"\r    -> Cluster {cid:4d} {total_str} : [WARNING] 0 frames passed filter.          \n")
                        logging.warning(f"\n      {Colors.YELLOW}[WARN]{Colors.RESET} No frames satisfy the RMSD threshold for Cluster {cid}. Retaining the complete structural ensemble.")
                        shutil.copy(temp_fitted_dcd, os.path.join(abs_results_dir, f"cluster_{cid:04d}.dcd"))
                else:
                    sys.stdout.write(f"\r    -> Cluster {cid:4d} {total_str} : Extracted {initial_frame_count} frames.                 \n")
                    shutil.copy(temp_fitted_dcd, os.path.join(abs_results_dir, f"cluster_{cid:04d}.dcd"))
            except (ValueError, IndexError, OSError) as e:
                logging.warning(f"\n      {Colors.YELLOW}[WARN]{Colors.RESET} Core RMSD evaluation failed ({e}) for Cluster {cid}. Retaining complete ensemble.")
                shutil.copy(temp_fitted_dcd, os.path.join(abs_results_dir, f"cluster_{cid:04d}.dcd"))
        else:
            sys.stdout.write(f"\r    -> Cluster {cid:4d} {total_str} : Extracted {initial_frame_count} frames (No RMSD log).       \n")
            shutil.copy(temp_fitted_dcd, os.path.join(abs_results_dir, f"cluster_{cid:04d}.dcd"))
        
        _, _, rc_rep = execute_carma_sandbox(["carma", "-v", "-first", str(nearest_centroid_frame), "-last", str(nearest_centroid_frame), "-pdb"] + extraction_flags + [abs_original_dcd, abs_original_psf], run_dir=tmp_dir)
        extracted_pdbs = [f for f in glob.glob(os.path.join(tmp_dir, "*.pdb")) if "superposition" not in f and "average" not in f]
        
        if rc_rep == 0 and extracted_pdbs:
            os.rename(extracted_pdbs[0], os.path.join(abs_results_dir, f"cluster_{cid:04d}_representative.pdb"))
            cluster_reps[cid] = nearest_centroid_frame
        else:
            sys.stdout.write(f"\r    -> Cluster {cid:4d} {total_str} : [FAILED] Representative structure error.      \n")
            cluster_reps[cid] = "FAILED"
            return False
            
        sys.stdout.flush()
        if fh:
            fh.flush()
        return True

def execute_structural_extraction(unique_clusters, labels, frames, data_nd, target_analysis_dir, results_dir, args, carma_stats, cluster_rmsds, cluster_reps, cluster_struct_counts, skip_processing=False):
    """Main loop managing trajectory slicing, alignment, and representative-structure extraction via carma."""
    search_link_dir = target_analysis_dir
    if 'carma_results_' not in target_analysis_dir:
        carma_dirs = glob.glob(os.path.join(target_analysis_dir, 'carma_results_*'))
        if carma_dirs: search_link_dir = max(carma_dirs, key=os.path.getmtime)
            
    atom_flags, source_str = parse_atom_extraction_flags(search_link_dir)
    segid_flag = ["-segid", args.segid] if args.segid else []
    extraction_flags = atom_flags + segid_flag
    
    dcd_links, psf_links = [], []
    for f in os.listdir(search_link_dir):
        full_path = os.path.join(search_link_dir, f)
        if os.path.islink(full_path) and os.path.exists(full_path):
            if f.endswith('.dcd'): dcd_links.append(full_path)
            elif f.endswith('.psf'): psf_links.append(full_path)

    dcd_links = sorted(dcd_links)
    psf_links = sorted(psf_links)

    base_dir = os.path.dirname(search_link_dir) if 'carma_results_' in search_link_dir else search_link_dir
    if not base_dir: base_dir = '.'
    
    fallback_dcds = sorted([os.path.join(base_dir, f) for f in os.listdir(base_dir) if f.endswith('.dcd') and not f.startswith(('carma', 'cluster', 'transitions', 'dPCA'))])
    fallback_psfs = sorted([os.path.join(base_dir, f) for f in os.listdir(base_dir) if f.endswith('.psf') and not f.startswith(('carma', 'cluster', 'transitions', 'dPCA'))])

    if len(dcd_links) > 1:
        logging.warning(f"{Colors.YELLOW}[WARN]{Colors.RESET} Multiple primary trajectory candidates detected:")
        for cand in dcd_links: logging.warning(f"       {os.path.basename(cand)}")
        logging.warning(f"       Selected: {os.path.basename(dcd_links[0])}")
    elif not dcd_links and len(fallback_dcds) > 1:
        logging.warning(f"{Colors.YELLOW}[WARN]{Colors.RESET} Multiple fallback trajectory candidates detected:")
        for cand in fallback_dcds: logging.warning(f"       {os.path.basename(cand)}")
        logging.warning(f"       Selected: {os.path.basename(fallback_dcds[0])}")
        
    if len(psf_links) > 1:
        logging.warning(f"{Colors.YELLOW}[WARN]{Colors.RESET} Multiple primary topology candidates detected:")
        for cand in psf_links: logging.warning(f"       {os.path.basename(cand)}")
        logging.warning(f"       Selected: {os.path.basename(psf_links[0])}")
    elif not psf_links and len(fallback_psfs) > 1:
        logging.warning(f"{Colors.YELLOW}[WARN]{Colors.RESET} Multiple fallback topology candidates detected:")
        for cand in fallback_psfs: logging.warning(f"       {os.path.basename(cand)}")
        logging.warning(f"       Selected: {os.path.basename(fallback_psfs[0])}")

    original_dcd = dcd_links[0] if dcd_links else (fallback_dcds[0] if fallback_dcds else None)
    original_psf = psf_links[0] if psf_links else (fallback_psfs[0] if fallback_psfs else None)

    abs_original_dcd = os.path.abspath(original_dcd) if original_dcd and os.path.exists(original_dcd) else None
    abs_original_psf = os.path.abspath(original_psf) if original_psf and os.path.exists(original_psf) else None
    abs_results_dir = os.path.abspath(results_dir)

    traj_discovery = "symlink in carma results directory" if dcd_links else "parent-directory fallback"
    top_discovery = "symlink in carma results directory" if psf_links else "parent-directory fallback"

    has_struct = bool(abs_original_dcd and abs_original_psf)

    struct_info = {
        'dcd': abs_original_dcd if abs_original_dcd else "N/A",
        'psf': abs_original_psf if abs_original_psf else "N/A",
        'traj_discovery': traj_discovery if abs_original_dcd else "N/A",
        'top_discovery': top_discovery if abs_original_psf else "N/A",
        'flags': " ".join(atom_flags).replace('-atomid', '').replace('-atmid', '').strip() if has_struct else "N/A",
        'source': source_str if has_struct else "not evaluated (no structural trajectory/topology)",
        'compatible': True,
        'bounds_valid': True,
        'preflight_error': None,
        'success_count': 0,
        'failed_count': 0
    }

    if skip_processing:
        return struct_info

    if not shutil.which("carma"):
        logging.warning(f"\n{Colors.YELLOW}[WARN]{Colors.RESET} 'carma' binary not found in system $PATH. Bypassing structural extraction.")
        return struct_info

    if not has_struct:
        logging.warning(f"{Colors.YELLOW}[WARN]{Colors.RESET} Missing fundamental trajectory (.dcd) or topology (.psf) files in {base_dir}. Bypassing extraction phase.")
        return struct_info

    logging.info(f"{Colors.BLUE}[+]{Colors.RESET} Trajectory file: {original_dcd}")
    logging.info(f"{Colors.BLUE}[+]{Colors.RESET} Topology file: {original_psf}\n")
    
    # PREFLIGHT ATOM SELECTION VERIFICATION
    requested_atoms = set()
    for i in range(len(extraction_flags) - 1):
        if extraction_flags[i] == '-atomid':
            requested_atoms.add(extraction_flags[i+1])
            
    if abs_original_psf:
        psf_atoms_present = set()
        psf_segments_present = set()
        try:
            with open(abs_original_psf, 'r') as f:
                in_atoms_section = False
                for line in f:
                    if '!NATOM' in line:
                        in_atoms_section = True
                        continue
                    if in_atoms_section:
                        line_strip = line.strip()
                        if not line_strip or '!NBOND' in line_strip:
                            break
                        parts = line.split()
                        if len(parts) >= 5 and parts[0].isdigit():
                            psf_segments_present.add(parts[1])
                            psf_atoms_present.add(parts[4])
        except Exception:
            pass # Fallback to carma preflight if parse fails
            
        if args.segid and psf_segments_present and args.segid not in psf_segments_present:
            logging.error(f"    {Colors.RED}[-]{Colors.RESET} Critical error: Requested segment '{args.segid}' was not found in the topology.")
            struct_info['compatible'] = False
            struct_info['preflight_error'] = 'missing_segment'
            struct_info['missing_segment'] = args.segid
            return struct_info
            
        if requested_atoms and psf_atoms_present:
            missing_atoms = requested_atoms - psf_atoms_present
            if missing_atoms:
                missing_str = " ".join(sorted(list(missing_atoms)))
                logging.error(f"    {Colors.RED}[-]{Colors.RESET} Critical error: Structural atom selection contains atom identifiers not present in the topology.")
                logging.error(f"        Missing identifiers : {missing_str}")
                logging.error(f"        Requested selection : {struct_info['flags']}")
                struct_info['compatible'] = False
                struct_info['preflight_error'] = 'missing_atoms'
                struct_info['missing_atoms'] = missing_str
                return struct_info

    # PREFLIGHT DCD/PSF CHECK & BOUNDS VALIDATION
    logging.info(f"    {Colors.LIGHT_BLUE}[*]{Colors.RESET} Executing preflight DCD/PSF compatibility check...")
    max_sampled_frame = int(np.max(frames))
    dcd_frames = None
    dcd_atoms = None
    psf_atoms = None

    with tempfile.TemporaryDirectory(dir=abs_results_dir) as tmp_dir:
        out, err, rc_preflight = execute_carma_sandbox(["carma", "-v", "-first", "1", "-last", "1", "-pdb"] + extraction_flags + [abs_original_dcd, abs_original_psf], run_dir=tmp_dir)
        combined_out = out + "\n" + err
        combined_lower = combined_out.lower()
        
        for line in combined_out.splitlines():
            line_lower = line.lower()
            if 'coordinate sets' in line_lower and dcd_frames is None:
                m = re.search(r'coordinate sets\s+is\s+(\d+)', line_lower)
                if m: dcd_frames = int(m.group(1))
                
            m_mismatch = re.search(r'number of atoms in psf and dcd do not match\s*\((\d+)\s+vs\s+(\d+)\)', line_lower)
            if m_mismatch:
                psf_atoms = int(m_mismatch.group(1))
                dcd_atoms = int(m_mismatch.group(2))
                
            m_dcd = re.search(r'number of atoms in sets is\s+(\d+)', line_lower)
            if m_dcd and dcd_atoms is None:
                dcd_atoms = int(m_dcd.group(1))

        struct_info['dcd_atoms'] = dcd_atoms
        struct_info['psf_atoms'] = psf_atoms
        struct_info['dcd_frames'] = dcd_frames
        struct_info['max_frame'] = max_sampled_frame

        if rc_preflight != 0:
            struct_info['compatible'] = False
            struct_info['preflight_error'] = 'generic'
            
            if 'less than two' in combined_lower and 'atoms found' in combined_lower:
                struct_info['preflight_error'] = 'selection'
                if args.segid:
                    logging.error(f"    {Colors.RED}[-]{Colors.RESET} Critical error: Requested segment '{args.segid}' or selection '{struct_info['flags']}' matched fewer than the required atoms.")
                else:
                    logging.error(f"    {Colors.RED}[-]{Colors.RESET} Critical error: Structural atom selection '{struct_info['flags']}' matched fewer than the required atoms.")
            elif m_mismatch or (dcd_atoms and psf_atoms and dcd_atoms != psf_atoms):
                struct_info['preflight_error'] = 'mismatch'
                logging.error(f"    {Colors.RED}[-]{Colors.RESET} Critical error: Structural trajectory and topology are incompatible.")
                logging.error(f"        Trajectory atom count : {dcd_atoms}")
                logging.error(f"        Topology atom count   : {psf_atoms}")
                logging.error(f"    {Colors.RED}[-]{Colors.RESET} DCD/PSF atom counts differ.")
            else:
                logging.error(f"    {Colors.RED}[-]{Colors.RESET} Critical error: Structural preflight failed; see execution log.")
            return struct_info
            
        if dcd_frames is not None and max_sampled_frame > dcd_frames:
            logging.error(f"    {Colors.RED}[-]{Colors.RESET} Critical error: Maximum sampled frame ID ({max_sampled_frame}) exceeds available DCD coordinate sets ({dcd_frames}).")
            struct_info['bounds_valid'] = False
            return struct_info
            
        logging.info(f"    {Colors.BLUE}[+]{Colors.RESET} Preflight check passed: structural inputs, atom selection, and frame bounds are valid.")
    
    total_clusters = len(unique_clusters)
    fh = get_clusterMD_file_handler()
    
    # Cluster extraction loop
    for index, cid in enumerate(unique_clusters):
        success = _process_single_cluster(
            cid, index, total_clusters, labels, frames, data_nd, 
            abs_original_dcd, abs_original_psf, abs_results_dir, 
            extraction_flags, args, carma_stats, cluster_rmsds, cluster_reps, cluster_struct_counts, fh
        )
        if success:
            struct_info['success_count'] += 1
        else:
            struct_info['failed_count'] += 1

    logging.info(f"\n    {Colors.LIGHT_BLUE}[*]{Colors.RESET} Processing unassigned/noise configurations (label -1)...")
    noise_mask = (labels == -1)
    if np.any(noise_mask):
        with tempfile.TemporaryDirectory(dir=abs_results_dir) as tmp_dir:
            noise_file = os.path.join(tmp_dir, "temp_frames_noise.dat")
            np.savetxt(noise_file, frames[noise_mask], fmt='%d')
            t_sub = time.time()
            _, _, rc_noise = execute_carma_sandbox(["carma", "-v", "-sort", "temp_frames_noise.dat", abs_original_dcd], run_dir=tmp_dir)
            carma_stats['sort'] += (time.time() - t_sub)
            if rc_noise == 0 and os.path.exists(os.path.join(tmp_dir, "carma.reordered.dcd")): 
                os.rename(os.path.join(tmp_dir, "carma.reordered.dcd"), os.path.join(abs_results_dir, "unassigned_noise.dcd"))

    logging.info(f"{Colors.BLUE}[+]{Colors.RESET} Structural extraction phase concluded.")
    return struct_info


# =========================================================================
# 7. PIPELINE EXECUTION
# =========================================================================
def get_shared_limits(pc_data, pad_ratio=0.05, min_pad=0.1):
    """Calculates shared axis bounds robust to zero-variance input."""
    ptp = np.ptp(pc_data)
    if ptp == 0:
        return (pc_data[0] - min_pad, pc_data[0] + min_pad), True
    pad = max(ptp * pad_ratio, min_pad)
    return (np.min(pc_data) - pad, np.max(pc_data) + pad), False

def run_full_pipeline(args, data_file, results_dir, target_analysis_dir, command_line):
    """Executes the complete clustering, observed-label-change, visualization, and structural-extraction sequence."""
    import matplotlib
    matplotlib.use('Agg') # Safe headless execution

    pipeline_start = time.time()
    process = psutil.Process(os.getpid())
    timing_stats = {'load': 0, 'hdbscan': 0, 'export': 0, 'plots': 0, 'extract': 0}
    carma_stats = {'sort': 0, 'rmsd': 0, 'super': 0}
    cluster_rmsds = {}
    cluster_reps = {}
    cluster_struct_counts = {}

    # 1. LOADING
    t0 = time.time()
    raw_data, parse_stats = ingest_trajectory_data(data_file, step=args.step)
    
    if len(raw_data) < 2:
        logging.error(f"{Colors.RED}[-]{Colors.RESET} Critical error: Insufficient valid frames sampled ({len(raw_data)}). Minimum 2 required.")
        sys.exit(1)
        
    if args.step > 1:
        logging.info(f"{Colors.LIGHT_BLUE}[*]{Colors.RESET} Applied frame stride of {args.step} during ingestion.")
        
    frames = raw_data[:, 0].astype(int)
    data_nd = raw_data[:, 1:] 
    available_dims = data_nd.shape[1]
    
    requested_dim = args.dim
    if args.dim > 0:
        if args.dim > available_dims:
            logging.warning(f"{Colors.YELLOW}[WARN]{Colors.RESET} Requested --dim {args.dim} exceeds available dimensions ({available_dims}). Capping to {available_dims}.")
            args.dim = available_dims
        data_nd = data_nd[:, :args.dim]
        logging.info(f"{Colors.LIGHT_BLUE}[*]{Colors.RESET} Constraining multidimensional analysis to the primary {args.dim} dimensions.")
        
    n_dimensions = data_nd.shape[1]
    total_frames = data_nd.shape[0]
    timing_stats['load'] = time.time() - t0
    logging.info(f"{Colors.BLUE}[+]{Colors.RESET} Data ingested successfully: {total_frames:,} frames ({n_dimensions}D).")

    if args.auto:
        scale_factor = math.sqrt(total_frames / 1_000_000.0)
        dynamic_size = max(100, int(500 * scale_factor))
        dynamic_samples = max(10, int(dynamic_size / 10.0))
        logging.info(f"{Colors.LIGHT_BLUE}[*]{Colors.RESET} Auto-scaling activated: min_cluster_size={dynamic_size}")
    else:
        dynamic_size = args.size
        dynamic_samples = args.samples if args.samples is not None else max(2, int(dynamic_size / 10.0))

    auto_status_console = "Active" if args.auto else "Inactive (manual parameters)"
    logging.info("\n" + "="*70)
    logging.info(f"{Colors.BOLD} ANALYSIS SETUP{Colors.RESET}")
    logging.info("="*70)
    logging.info(f"  Projection file      : {os.path.basename(data_file)}")
    logging.info(f"  Frames analyzed      : {total_frames:,}")
    logging.info(f"  Frame stride         : {args.step}")
    logging.info(f"  Dimensions used      : {n_dimensions}")
    logging.info(f"  Temperature          : {args.temp} K")
    logging.info(f"  HDBSCAN method       : {args.method}")
    logging.info(f"  min_cluster_size     : {dynamic_size}")
    logging.info(f"  min_samples          : {dynamic_samples}")
    logging.info(f"  Auto-scaling         : {auto_status_console}")
    logging.info("="*70)

    # 2. CLUSTERING
    logging.info(f"\n{Colors.LIGHT_BLUE}[*]{Colors.RESET} Running HDBSCAN clustering...")
    labels, timing_stats['hdbscan'] = execute_clustering_algorithm(data_nd, dynamic_size, dynamic_samples, args.method)
    
    initial_cluster_count = len(np.unique(labels[labels != -1]))
    logging.info(f"{Colors.BLUE}[+]{Colors.RESET} Identified {initial_cluster_count} clusters in {timing_stats['hdbscan']:.2f} seconds.")
    
    logging.info(f"{Colors.LIGHT_BLUE}[*]{Colors.RESET} Sorting cluster assignments by descending population size...")
    labels, unique_clusters = sort_cluster_populations(labels)

    noise_frames = np.sum(labels == -1)
    assigned_frames = total_frames - noise_frames
    logging.info("\n    CLUSTER POPULATIONS")
    logging.info("    " + "-"*49)
    logging.info(f"    {'Cluster':<10}{'Frames':>12}{'Population':>15}")
    logging.info("    " + "-"*49)
    for cid in unique_clusters:
        count = np.sum(labels == cid)
        logging.info(f"    {cid:<10d}{count:>12,d}{(count / total_frames) * 100:>14.1f}%")
    logging.info("    " + "-"*49)
    logging.info(f"    {'Unassigned':<10}{noise_frames:>12,d}{(noise_frames / total_frames) * 100:>14.1f}%")
    logging.info("    " + "-"*49)
    logging.info(f"    Assigned frames    : {assigned_frames:,} ({(assigned_frames / total_frames) * 100:.1f}%)")
    logging.info(f"    Unassigned / noise : {noise_frames:,} ({(noise_frames / total_frames) * 100:.1f}%)")
    logging.info(f"    Clusters identified: {len(unique_clusters)}")

    t0 = time.time()
    out_filename = os.path.join(results_dir, f"hdbscan.{n_dimensions}-D.clusters.dat")
    logging.info(f"\n{Colors.LIGHT_BLUE}[*]{Colors.RESET} Exporting assigned coordinate matrices to {out_filename}...")
    export_cluster_coordinates(frames, labels, data_nd, out_filename, n_dimensions)
    timing_stats['export'] = time.time() - t0

    has_duplicates = parse_stats['sampled_duplicates']
    non_monotonic = not parse_stats['sampled_monotonic']
    fatal_frame_error = has_duplicates or non_monotonic
    
    skip_label_changes = non_monotonic or has_duplicates
    skip_structural = has_duplicates

    if has_duplicates:
        logging.warning(f"\n{Colors.YELLOW}[WARN]{Colors.RESET} Duplicate sampled frame identifiers detected.")
        logging.warning(f"       Clustering assignments are valid in coordinate space,")
        logging.warning(f"       but one-to-one structural frame mapping is ambiguous.")
    if non_monotonic:
        prefix = "" if has_duplicates else "\n"
        logging.warning(f"{prefix}{Colors.YELLOW}[WARN]{Colors.RESET} Sampled frame identifiers are not strictly increasing.")
        logging.warning(f"       Clustering assignments are valid in coordinate space,")
        logging.warning(f"       but chronological interpretation of this assignment file is not valid.")

    if args.cluster_only:
        elapsed = time.time() - pipeline_start
        logging.info(f"\n{Colors.BLUE}[+]{Colors.RESET} Cluster-only mode complete.")
        logging.info(f"    Frames analyzed      : {total_frames:,}")
        logging.info(f"    Clusters identified  : {len(unique_clusters)}")
        logging.info(f"    Assigned frames      : {assigned_frames:,} ({assigned_frames / total_frames * 100:.2f}%)")
        logging.info(f"    Unassigned / noise   : {noise_frames:,} ({noise_frames / total_frames * 100:.2f}%)")
        logging.info(f"    HDBSCAN runtime      : {timing_stats['hdbscan']:.2f}s")
        logging.info(f"    Assignment file      : {out_filename}")
        logging.info(f"    Total runtime        : {elapsed:.2f}s")
        return

    if has_duplicates:
        logging.error(f"\n{Colors.RED}[-]{Colors.RESET} Critical error: Duplicate sampled frame identifiers detected.")
    if non_monotonic:
        prefix = "" if has_duplicates else "\n"
        logging.error(f"{prefix}{Colors.RED}[-]{Colors.RESET} Critical error: Sampled frame identifiers are not strictly increasing.")

    if skip_label_changes and skip_structural:
        logging.warning(f"{Colors.YELLOW}[*]{Colors.RESET} Bypassing observed label-change analysis, connectivity visualizations, and structural extraction.")
    elif skip_label_changes:
        logging.warning(f"{Colors.YELLOW}[*]{Colors.RESET} Bypassing observed label-change analysis and connectivity visualizations.")

    # 3. OBSERVED LABEL CHANGES
    logging.info(f"{Colors.LIGHT_BLUE}[*]{Colors.RESET} Mapping observed changes between assigned cluster labels...")
    states, counts, population_map, _, k_B_T = calculate_populations_and_energies(labels, args.temp)
    num_states = len(states)
    
    if not skip_label_changes:
        label_changes = map_observed_label_changes(labels)
        sorted_changes = print_top_observed_changes(label_changes, args.top)
        top_edges = [edge for edge, count in sorted_changes[:args.top]]
        
        changes_file = os.path.join(results_dir, "observed_label_changes_report.txt")
        with open(changes_file, "w") as cf:
            cf.write("============================================================\n")
            cf.write("OBSERVED LABEL CHANGES\n")
            cf.write("============================================================\n\n")
            cf.write(f"{'Cluster pair':<40}{'Observed changes':>20}\n")
            cf.write("-" * 60 + "\n")
            for edge, count in sorted_changes:
                pair_str = f"{edge[0]} <--> {edge[1]}"
                cf.write(f"{pair_str:<40}{count:>20d}\n")
            cf.write("-" * 60 + "\n")
            cf.write(f"{'Unique cluster pairs':<40}{len(label_changes):>20d}\n")
        logging.info(f"{Colors.BLUE}[+]{Colors.RESET} Observed-change report saved to: {changes_file}")
    
        if args.transitions is not None and len(args.transitions) == 2:
            logging.info("\n" + "="*85)
            logging.info(f"{Colors.LIGHT_BLUE}[*]{Colors.RESET} DIAGNOSTIC MODE: INSPECTING OBSERVED CHANGES FOR CLUSTER PAIR {tuple(sorted(args.transitions))}")
            logging.info("="*85)
            hunt_chronological_label_changes(tuple(sorted(args.transitions)), labels, frames, data_nd, args.events)
    else:
        label_changes, top_edges = {}, []
        logging.info(f"    -> Skipped due to chronological validation failure.")

    # 4. VISUALIZATION
    plot_status = {
        'landscape': 'Completed', 
        'fes_connectivity': 'Completed', 
        'pcoa_connectivity': 'Completed'
    }
    
    logging.info(f"\n{Colors.LIGHT_BLUE}[*]{Colors.RESET} Generating static conformational projections and free-energy surfaces...")
    t0_plots = time.time()
    
    pc1 = data_nd[:, 0]
    pc2 = data_nd[:, 1] if n_dimensions >= 2 else None

    if n_dimensions >= 2:
        xlim, x_degen = get_shared_limits(pc1)
        ylim, y_degen = get_shared_limits(pc2)
        zero_var_2d = x_degen or y_degen
        
        render_conformational_landscape(pc1, pc2, xlim, ylim, "1", "2", unique_clusters, labels, zero_var_2d, os.path.join(results_dir, "landscape_PC1_vs_PC2"))
        
        if zero_var_2d:
            logging.warning(f"    {Colors.YELLOW}[WARN]{Colors.RESET} Zero variance detected in primary dimensions. Bypassing free-energy surface connectivity overlay.")
            plot_status['fes_connectivity'] = 'Skipped (zero variance in projection)'
        else:
            if num_states > 0:
                if skip_label_changes:
                    logging.info("    -> Rendering population-derived FES without connectivity...")
                else:
                    logging.info("    -> Rendering FES with observed cluster connectivity...")
                render_fes_connectivity(pc1, pc2, unique_clusters, labels, k_B_T, xlim, ylim, label_changes, top_edges, os.path.join(results_dir, "FES_Connectivity_PC1_vs_PC2.png"))
                if skip_label_changes:
                    plot_status['fes_connectivity'] = 'FES completed; connectivity not performed (chronological validation failure)'
            else:
                logging.info(f"    -> Bypassing FES connectivity overlay (0 clusters assigned).")
                plot_status['fes_connectivity'] = 'Skipped (0 clusters assigned)'
    else:
        logging.info(f"    -> Bypassing 2D visualizations (1D input detected).")
        for p in ['landscape', 'fes_connectivity']:
            plot_status[p] = 'Skipped (1D input)'

    if n_dimensions >= 3:
        zlim, z_degen = get_shared_limits(data_nd[:, 2])
        if not (x_degen or z_degen):
            render_conformational_landscape(data_nd[:, 0], data_nd[:, 2], xlim, zlim, "1", "3", unique_clusters, labels, False, os.path.join(results_dir, "landscape_PC1_vs_PC3"))
        if not (y_degen or z_degen):
            render_conformational_landscape(data_nd[:, 1], data_nd[:, 2], ylim, zlim, "2", "3", unique_clusters, labels, False, os.path.join(results_dir, "landscape_PC2_vs_PC3"))

    if not skip_label_changes:
        if num_states > 2:
            logging.info(f"    -> Rendering principal coordinate analysis (PCoA) of cluster medians...")
            render_pcoa_connectivity(num_states, data_nd, labels, states, population_map, label_changes, top_edges, os.path.join(results_dir, "PCoA_Connectivity_Cluster_Medians.png"))
        else:
            plot_status['pcoa_connectivity'] = 'Skipped (requires >2 clusters)'
    else:
        plot_status['pcoa_connectivity'] = 'Not performed (chronological validation failure)'

    timing_stats['plots'] = time.time() - t0_plots

    # 5. EXTRACTING
    if not skip_structural:
        logging.info(f"\n{Colors.LIGHT_BLUE}[*]{Colors.RESET} Extracting cluster-associated structural ensembles via carma...")
        t0_extract = time.time()
        struct_info = execute_structural_extraction(unique_clusters, labels, frames, data_nd, target_analysis_dir, results_dir, args, carma_stats, cluster_rmsds, cluster_reps, cluster_struct_counts, skip_processing=False)
        if not struct_info: struct_info = {}
        timing_stats['extract'] = time.time() - t0_extract
    else:
        struct_info = execute_structural_extraction(unique_clusters, labels, frames, data_nd, target_analysis_dir, results_dir, args, carma_stats, cluster_rmsds, cluster_reps, cluster_struct_counts, skip_processing=True)
        if not struct_info: struct_info = {}

    # 6. REPORT GENERATION
    logging.info(f"\n{Colors.LIGHT_BLUE}[*]{Colors.RESET} Writing detailed analysis report...")
    
    fatal_struct_error = False
    if struct_info.get('dcd') and struct_info.get('dcd') != 'N/A':
        if struct_info.get('compatible') is False or struct_info.get('bounds_valid') is False:
            fatal_struct_error = True
        elif struct_info.get('failed_count', 0) > 0:
            fatal_struct_error = True
            
    overall_fatal_error = fatal_frame_error or fatal_struct_error
    
    generate_execution_report(
        results_dir, pipeline_start, process, total_frames, args, n_dimensions, available_dims, requested_dim,
        dynamic_size, dynamic_samples, target_analysis_dir, data_file, timing_stats, 
        carma_stats, unique_clusters, labels, cluster_rmsds, cluster_struct_counts, parse_stats, struct_info, cluster_reps, 
        command_line, skip_label_changes, skip_structural, fatal_frame_error, fatal_struct_error, plot_status
    )
    
    if overall_fatal_error:
        sys.exit(1)

def run_diagnostic_validation(args, dat_file):
    """Bypasses the full pipeline and inspects chronological observed label changes."""
    raw_data, _ = ingest_trajectory_data(dat_file, step=1)
        
    frames = raw_data[:, 0].astype(int)
    labels = raw_data[:, 1].astype(int)
    data_nd = raw_data[:, 2:]
    
    label_changes = map_observed_label_changes(labels)
        
    logging.info("\n" + "="*85)
    if len(args.transitions) == 2:
        logging.info(f"{Colors.LIGHT_BLUE}[*]{Colors.RESET} DIAGNOSTIC MODE: INSPECTING OBSERVED CHANGES FOR CLUSTER PAIR {tuple(sorted(args.transitions))}")
    else:
        logging.info(f"{Colors.LIGHT_BLUE}[*]{Colors.RESET} DIAGNOSTIC MODE: OBSERVED CHANGE OVERVIEW")
    logging.info("="*85)
    
    print_top_observed_changes(label_changes, args.top)
    
    if len(args.transitions) == 2:
        hunt_chronological_label_changes(tuple(sorted(args.transitions)), labels, frames, data_nd, args.events)
        
    logging.info(f"{Colors.BLUE}[+]{Colors.RESET} Validation complete. Exiting smoothly without triggering extraction pipeline.\n")
    sys.exit(0)

def generate_execution_report(results_dir, pipeline_start, process, total_frames, args, n_dimensions, available_dims, requested_dim, dynamic_size, dynamic_samples, target_analysis_dir, data_file, timing_stats, carma_stats, unique_clusters, labels, cluster_rmsds, cluster_struct_counts, parse_stats, struct_info, cluster_reps, command_line, skip_label_changes=False, skip_structural=False, fatal_frame_error=False, fatal_struct_error=False, plot_status=None):
    
    if plot_status is None:
        plot_status = {}

    def calculate_variance_explained(dim_used, target_dir):
        eig_files = glob.glob(os.path.join(target_dir, '*eigenvalues.dat'))
        if not eig_files: return "N/A"
        
        eig_file = max(eig_files, key=os.path.getmtime)
        if len(eig_files) > 1:
            logging.warning(f"{Colors.YELLOW}[WARN]{Colors.RESET} Multiple eigenvalue files found.")
            logging.warning(f"       Selected: {os.path.basename(eig_file)}")
        
        try:
            eigenvalues = np.loadtxt(eig_file)
            total_variance = np.sum(eigenvalues)
            used_variance = np.sum(eigenvalues[:dim_used])
            return f"{(used_variance / total_variance) * 100:.1f}%"
        except (FileNotFoundError, ValueError, IndexError) as e: 
            logging.warning(f"{Colors.YELLOW}[WARN]{Colors.RESET} Unable to calculate represented variance ({e}).")
            return "Error"

    report_filename = os.path.join(results_dir, "clusterMD_analysis_report.txt")
    total_pipeline_time = time.time() - pipeline_start
    resident_ram_gb = process.memory_info().rss / (1024 ** 3)
    cpu_cores = psutil.cpu_count(logical=True)
    variance_str = calculate_variance_explained(n_dimensions, target_analysis_dir)
    noise_frames = np.sum(labels == -1)
    assigned_frames = total_frames - noise_frames
    auto_status = "Active (sub-linear heuristic)" if args.auto else "Inactive (manual parameters)"
    env = get_software_env()
    
    carma_missing = env['carma_path'] == 'NOT FOUND'
    has_struct = struct_info.get('dcd') and struct_info.get('dcd') != 'N/A'

    with open(report_filename, "w") as report:
        report.write("============================================================\n")
        report.write("clusterMD ANALYSIS REPORT\n")
        report.write("============================================================\n\n")

        report.write("--- RUN INVOCATION ---\n")
        report.write(f"Command line : {command_line}\n\n")

        report.write("--- SOFTWARE ENVIRONMENT ---\n")
        report.write(f"clusterMD version          : {env['clusterMD_ver']}\n")
        report.write(f"Python version             : {env['python_ver']}\n")
        report.write(f"fast_hdbscan version       : {env['fh_ver']}\n")
        report.write(f"NumPy version              : {env['numpy_ver']}\n")
        report.write(f"SciPy version              : {env['scipy_ver']}\n")
        report.write(f"carma executable           : {env['carma_path']}\n")
        report.write(f"carma version              : {env['carma_ver']}\n\n")

        report.write("--- INPUT PROVENANCE ---\n")
        report.write(f"Projection file               : {os.path.basename(data_file)}\n")
        report.write(f"Projection absolute path      : {os.path.abspath(data_file)}\n")
        report.write(f"Input lines detected          : {parse_stats['total_lines']}\n")
        report.write(f"Rows selected by stride       : {parse_stats['selected_by_stride']}\n")
        report.write(f"Valid sampled rows            : {parse_stats['valid_sampled']}\n")
        report.write(f"Malformed sampled rows skipped: {parse_stats['malformed_sampled']}\n")
        report.write(f"Rows entering HDBSCAN         : {parse_stats['valid_sampled']}\n")
        
        req_dim_str = f"{requested_dim}" if requested_dim > 0 else "ALL (dim=0)"
        report.write(f"Requested dimensions          : {req_dim_str}\n")
        report.write(f"Available dimensions          : {available_dims}\n")
        report.write(f"Dimensions analyzed           : {n_dimensions}\n")
        
        report.write(f"First sampled frame ID        : {parse_stats['first_sampled_frame']}\n")
        report.write(f"Last sampled frame ID         : {parse_stats['last_sampled_frame']}\n")
        report.write(f"Sampled frame IDs monotonic   : {'YES' if parse_stats['sampled_monotonic'] else 'NO'}\n")
        report.write(f"Duplicate sampled frame IDs   : {'YES' if parse_stats['sampled_duplicates'] else 'NO'}\n")
        report.write(f"Frame stride                  : {args.step}\n\n")

        report.write("--- STRUCTURAL INPUTS ---\n")
        report.write(f"Trajectory file            : {struct_info.get('dcd', 'N/A')}\n")
        report.write(f"Topology file              : {struct_info.get('psf', 'N/A')}\n")
        report.write(f"Trajectory discovery       : {struct_info.get('traj_discovery', 'N/A')}\n")
        report.write(f"Topology discovery         : {struct_info.get('top_discovery', 'N/A')}\n")
        report.write(f"Structural atom selection  : {struct_info.get('flags', 'N/A')}\n")
        report.write(f"Selection source           : {struct_info.get('source', 'N/A')}\n\n")

        report.write("--- VALIDATION & ASSUMPTIONS ---\n")
        report.write(f"[PASS] Projection file parsed successfully.\n")
        
        if parse_stats['malformed_sampled'] > 0:
            malformed_pct = (parse_stats['malformed_sampled'] / max(1, parse_stats['selected_by_stride'])) * 100
            report.write(f"[WARN] {parse_stats['malformed_sampled']} of {parse_stats['selected_by_stride']} sampled input rows ({malformed_pct:.2f}%) were malformed and skipped.\n")
            
        report.write(f"[PASS] {parse_stats['valid_sampled']} valid sampled rows entered clustering.\n")
        
        if parse_stats['sampled_monotonic']:
            report.write("[PASS] Sampled frame identifiers are strictly increasing.\n")
        else:
            report.write("[FAIL] Sampled frame identifiers are not strictly increasing; chronological label-change analysis would not represent trajectory order.\n")
            
        if not parse_stats['sampled_duplicates']:
            report.write("[PASS] No duplicate frame identifiers detected.\n")
        else:
            report.write("[FAIL] Duplicate sampled frame identifiers detected. Each projection row must map unambiguously to one trajectory frame.\n")

        report.write(f"[PASS] No non-finite PCA/dPCA coordinates were detected in sampled rows.\n")
        
        if requested_dim == 0:
            report.write(f"[PASS] All available dimensions were used as requested.\n")
        elif requested_dim > available_dims:
            report.write(f"[WARN] Requested dimensionality ({requested_dim}) exceeded available dimensions ({available_dims}); analysis was capped to {n_dimensions} dimensions.\n")
        else:
            report.write(f"[PASS] Requested dimensionality ({requested_dim}) is available.\n")
        
        if not carma_missing:
            report.write(f"[PASS] carma executable found: {env['carma_path']}\n")
            report.write(f"[PASS] carma version detected: {env['carma_ver']}\n")
        else:
            report.write(f"[WARN] carma executable NOT FOUND.\n")
            
        report.write(f"[{'PASS' if has_struct else 'WARN'}] Structural trajectory and topology {'located' if has_struct else 'NOT FOUND'}.\n")
        
        if carma_missing:
            report.write(f"[INFO] DCD/PSF compatibility was not assessed because carma is unavailable.\n")
            report.write(f"[INFO] Trajectory frame bounds were not assessed because carma is unavailable.\n")
        elif has_struct and not skip_structural:
            if struct_info.get('compatible') is False:
                err_type = struct_info.get('preflight_error')
                if err_type == 'selection':
                    if args.segid:
                        report.write(f"[FAIL] Requested segment '{args.segid}' or selection '{struct_info.get('flags')}' matched fewer than the required atoms. Structural extraction aborted.\n")
                    else:
                        report.write(f"[FAIL] Structural atom selection '{struct_info.get('flags')}' matched fewer than the required atoms. Structural extraction aborted.\n")
                elif err_type == 'missing_segment':
                    report.write(f"[FAIL] Requested segment '{struct_info.get('missing_segment')}' was not found in the topology.\n")
                    report.write(f"       Structural extraction aborted.\n")
                    report.write(f"[INFO] DCD/PSF compatibility and trajectory frame bounds were not assessed because segment validation failed.\n")
                elif err_type == 'missing_atoms':
                    report.write(f"[FAIL] Structural atom selection contains atom identifiers not present in the topology.\n")
                    report.write(f"       Missing identifiers : {struct_info.get('missing_atoms')}\n")
                    report.write(f"       Requested selection : {struct_info.get('flags')}\n")
                    report.write(f"       Structural extraction aborted.\n")
                    report.write(f"[INFO] DCD/PSF compatibility and trajectory frame bounds were not assessed because atom-selection validation failed.\n")
                elif err_type == 'mismatch':
                    report.write(f"       Trajectory atom count : {struct_info.get('dcd_atoms')}\n")
                    report.write(f"       Topology atom count   : {struct_info.get('psf_atoms')}\n")
                    report.write(f"[FAIL] DCD/PSF atom counts differ. Structural extraction aborted.\n")
                else:
                    report.write(f"[FAIL] Structural preflight failed; see execution log. Structural extraction aborted.\n")
                    
                if err_type not in ('missing_atoms', 'missing_segment'):
                    if struct_info.get('bounds_valid') is False:
                        report.write(f"[FAIL] Maximum sampled frame ID ({struct_info.get('max_frame')}) exceeds available DCD coordinate sets ({struct_info.get('dcd_frames')}).\n")
                        report.write("       Structural extraction aborted.\n")
                    elif struct_info.get('dcd_frames') is None:
                        report.write(f"[INFO] Trajectory frame bounds were not assessed due to structural preflight failure.\n")
            else:
                report.write(f"[PASS] DCD/PSF compatibility check passed.\n")
                
                if struct_info.get('bounds_valid') is False:
                    report.write(f"[FAIL] Maximum sampled frame ID ({struct_info.get('max_frame')}) exceeds available DCD coordinate sets ({struct_info.get('dcd_frames')}).\n")
                    report.write("       Structural extraction aborted.\n")
                elif struct_info.get('bounds_valid') is True:
                    report.write(f"[PASS] Sampled frame identifiers are within available trajectory bounds.\n")
        report.write("\n")
        
        report.write("[INFO] Cluster IDs are reordered by descending population.\n")
        report.write("[INFO] Label -1 denotes HDBSCAN-unassigned configurations.\n")
        
        if skip_label_changes:
            report.write("[INFO] Observed label-change analysis and connectivity visualizations were not performed because sampled frame identifiers failed chronological validation.\n")
        else:
            report.write("[INFO] Observed label changes are counted after omitting unassigned frames.\n")
            
        if skip_structural:
            report.write("[INFO] Structural representative extraction was not performed due to duplicate frame identifiers.\n")
            
        if args.rmsd > 0:
            report.write("[INFO] Representative structures refer to the original HDBSCAN cluster and are selected before optional downstream RMSD filtering.\n")

        if skip_structural or not has_struct or fatal_struct_error or carma_missing:
            report.write("[INFO] When structural extraction is performed, representative structures are observed trajectory frames nearest the arithmetic centroid in retained coordinate space.\n\n")
        else:
            report.write("[INFO] Representative structures are observed trajectory frames nearest the arithmetic centroid in retained coordinate space.\n\n")
        
        if has_struct:
            report.write("[WARN] Projection-to-DCD frame correspondence is inferred from supplied frame identifiers and cannot be independently proven.\n")
        else:
            report.write("[INFO] Projection-to-trajectory frame correspondence was not assessed because no structural trajectory was located.\n")
            
        report.write("[WARN] Population-derived free-energy estimates assume representative equilibrium sampling and should not be interpreted as kinetic barriers.\n\n")

        report.write("--- ANALYSIS CONFIGURATION ---\n")
        report.write(f"Cumulative variance represented by analyzed components : {variance_str}\n")
        report.write(f"Temperature used for free-energy estimates           : {args.temp} K\n")
        report.write(f"Target segment                                       : {args.segid if args.segid else 'ALL'}\n\n")

        report.write("--- HDBSCAN PARAMETERS ---\n")
        report.write(f"Cluster selection method : {args.method}\n")
        report.write(f"Auto-scaling             : {auto_status}\n")
        report.write(f"min_cluster_size         : {dynamic_size}\n")
        report.write(f"min_samples              : {dynamic_samples}\n\n")

        report.write("--- VISUALIZATION STATUS ---\n")
        report.write(f"Conformational landscape : {plot_status.get('landscape', 'N/A')}\n")
        report.write(f"FES & Connectivity       : {plot_status.get('fes_connectivity', 'N/A')}\n")
        report.write(f"PCoA & Connectivity      : {plot_status.get('pcoa_connectivity', 'N/A')}\n\n")

        report.write("--- STRUCTURAL PROCESSING ---\n")
        report.write(f"RMSD structural filter   : {'Active' if args.rmsd > 0 else 'Inactive'}\n")
        if args.rmsd > 0:
            report.write(f"RMSD threshold           : {args.rmsd} Å\n")
        report.write("Unassigned interpretation: retained as unassigned/noise configurations\n\n")

        report.write("--- RESULTS SUMMARY ---\n")
        report.write(f"Clusters identified      : {len(unique_clusters)}\n")
        report.write(f"Assigned frames          : {assigned_frames:,} ({(assigned_frames / total_frames) * 100:.2f}%)\n")
        report.write(f"Unassigned/noise frames  : {noise_frames:,} ({(noise_frames / total_frames) * 100:.2f}%)\n\n")

        report.write("--- SYSTEM & RUNTIME ---\n")
        report.write(f"Logical CPU cores detected       : {cpu_cores}\n")
        report.write(f"Process RSS at report generation : {resident_ram_gb:.2f} GB\n")
        report.write(f"Total pipeline runtime           : {format_duration(total_pipeline_time)}\n\n")

        report.write("[ Measured stage runtimes ]\n")
        report.write(f"  Data ingestion (I/O)     : {timing_stats.get('load', 0):7.2f} s\n")
        report.write(f"  HDBSCAN clustering       : {timing_stats.get('hdbscan', 0):7.2f} s\n")
        report.write(f"  Coordinate export        : {timing_stats.get('export', 0):7.2f} s\n")
        report.write(f"  Visualization            : {timing_stats.get('plots', 0):7.2f} s\n")
        report.write(f"  carma structural process : {timing_stats.get('extract', 0):7.2f} s\n")
        report.write(f"    ├── Frame extraction   : {carma_stats.get('sort', 0):7.2f} s\n")
        report.write(f"    ├── Alignment/RMSD     : {carma_stats.get('rmsd', 0):7.2f} s\n")
        report.write(f"    └── Superposition      : {carma_stats.get('super', 0):7.2f} s\n\n")

        report.write("--- CLUSTER POPULATION & STRUCTURAL SUMMARY ---\n")
        if args.rmsd > 0:
            report.write(f"{'Cluster':<8} {'HDBSCAN Frames':>15} {'Structural Frames':>18} {'Retained %':>12} {'Rep. Frame':>12} {'Max RMSD to avg (Å)':>21}\n")
            report.write("-" * 88 + "\n")
        else:
            report.write(f"{'Cluster':<8} {'Frames':>10} {'Population':>12} {'Rep. Frame':>12} {'Max RMSD to avg (Å)':>21}\n")
            report.write("-" * 67 + "\n")
            
        for cid in unique_clusters:
            count = np.sum(labels == cid)
            percentage = (count / total_frames) * 100
            rep_frame = cluster_reps.get(cid, "N/A")
            rmsd_str = f"{cluster_rmsds.get(cid, -1.0):.2f}" if cluster_rmsds.get(cid, -1.0) >= 0 else "N/A"
            if args.rmsd > 0:
                struct_frames = cluster_struct_counts.get(cid, count)
                ret_pct = (struct_frames / count) * 100
                report.write(f"{cid:<8d} {count:15,d} {struct_frames:18,d} {ret_pct:11.2f}% {rep_frame:>12} {rmsd_str:>21}\n")
            else:
                report.write(f"{cid:<8d} {count:10,d} {percentage:11.2f}% {rep_frame:>12} {rmsd_str:>21}\n")
        report.write("============================================================\n")

    logging.info(f"{Colors.BLUE}[+]{Colors.RESET} Detailed report saved to: {report_filename}")
    logging.info("\n" + "="*70)
    
    overall_fatal_error = fatal_frame_error or fatal_struct_error

    if overall_fatal_error:
        logging.info(f"{Colors.BOLD} PARTIAL ANALYSIS COMPLETE{Colors.RESET}")
    else:
        logging.info(f"{Colors.BOLD} ANALYSIS COMPLETE{Colors.RESET}")
        
    logging.info("="*70)
    logging.info(f"  Frames analyzed        : {total_frames:,}")
    logging.info(f"  Clusters identified    : {len(unique_clusters)}")
    
    if overall_fatal_error:
        logging.info(f"  Validation status      : FAILED (See report for details)")
    else:
        logging.info(f"  Validation status      : PASSED")
        
    logging.info(f"  Observed changes mapping : {'Not performed' if skip_label_changes else 'Completed'}")
    
    # Summarize visualization completion from individual plot outcomes.
    plot_values = list(plot_status.values())
    if skip_label_changes:
        vis_status = "Partial (visualizations lacking temporal data)"
    elif any("zero variance" in status.lower() for status in plot_values):
        vis_status = "Partial (skipped zero variance)"
    elif any(status.startswith(("Skipped", "Not performed")) for status in plot_values):
        if plot_status.get('pcoa_connectivity', '').startswith('Skipped (requires >2 clusters)'):
            vis_status = "Partial (PCoA requires >2 clusters)"
        else:
            vis_status = "Partial"
    else:
        vis_status = "Completed"
        
    logging.info(f"  Visualizations           : {vis_status}")
    
    if skip_structural:
        struct_status = "Not performed (duplicate frame IDs)"
    elif carma_missing:
        struct_status = "Skipped (carma unavailable)"
    elif not has_struct:
        struct_status = "Skipped (DCD/PSF unavailable)"
    elif struct_info.get('compatible') is False:
        err_type = struct_info.get('preflight_error')
        if err_type == 'selection':
            struct_status = "Not performed (invalid atom selection)"
        elif err_type == 'missing_segment':
            struct_status = "Not performed (invalid segment selection)"
        elif err_type == 'missing_atoms':
            struct_status = "Not performed (missing atom identifiers)"
        elif err_type == 'mismatch':
            struct_status = "Not performed (DCD/PSF incompatible)"
        else:
            struct_status = "Not performed (structural preflight failed)"
    elif struct_info.get('bounds_valid') is False:
        struct_status = "Not performed (frame IDs exceed trajectory bounds)"
    else:
        success_count = struct_info.get('success_count', 0)
        failed_count = struct_info.get('failed_count', 0)
        if failed_count > 0:
            if success_count == 0:
                struct_status = f"Failed ({success_count}/{success_count+failed_count} successful)"
            else:
                struct_status = f"Partial ({success_count}/{success_count+failed_count} successful)"
        else:
            struct_status = "Completed"
        
    logging.info(f"  Structural extraction    : {struct_status}")
    logging.info(f"  Results directory        : {results_dir}/")
    logging.info("="*70)


# =========================================================================
# COMMAND-LINE INTERFACE
# =========================================================================
if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Automated HDBSCAN clustering, observed change mapping, and structural extraction pipeline.")
    parser.add_argument('--size', type=int, default=500, help='HDBSCAN min_cluster_size (Default: 500)')
    parser.add_argument('--samples', type=int, default=50, help='HDBSCAN min_samples (Default: 50)')
    parser.add_argument('--auto', action='store_true', help='Set min_cluster_size and min_samples using the frame-count heuristic')
    parser.add_argument('--cluster-only', action='store_true', help='Run ingestion and HDBSCAN clustering, export assignments, then exit before downstream analysis.')
    parser.add_argument('--method', type=str, default='eom', choices=['eom', 'leaf'], help='HDBSCAN cluster-selection method (Default: eom)')
    parser.add_argument('--dim', type=int, default=0, help='Number of projected dimensions to analyze; 0 uses all available dimensions')
    parser.add_argument('--rmsd', type=float, default=0.0, help='Optional RMSD threshold for downstream structural filtering in Angstrom; 0 disables filtering')
    parser.add_argument('--temp', type=float, default=298.0, help='Temperature in Kelvin used for population-derived free-energy estimates (Default: 298.0)')
    parser.add_argument('--step', type=int, default=1, help='Frame stride applied during projection-file ingestion (Default: 1)')
    parser.add_argument('--segid', type=str, default=None, help='Restrict structural extraction to the specified segment identifier')
    parser.add_argument('--top', type=int, default=15, help="Number of observed changes to display in the diagnostic table and plots (Default: 15. 0 disables displayed edges)")
    parser.add_argument('--transitions', '--changes', dest='transitions', nargs='*', type=int, help="Pass 0 args to view the most frequent observed changes, or 2 cluster IDs to inspect a specific cluster pair.")
    parser.add_argument('--events', type=int, default=3, help="Maximum chronological change events to print in diagnostic mode (Default: 3)")

    args = parser.parse_args()

    command_line = " ".join([shlex.quote(os.path.basename(sys.argv[0]))] + [shlex.quote(arg) for arg in sys.argv[1:]])

    # Input validation
    if args.size <= 0: parser.error("--size must be a positive integer.")
    if args.samples is not None and args.samples <= 0: parser.error("--samples must be a positive integer.")
    if args.step <= 0: parser.error("--step must be a positive integer.")
    if args.temp <= 0: parser.error("--temp must be strictly positive (K).")
    if args.rmsd < 0: parser.error("--rmsd must be non-negative.")
    if args.dim < 0: parser.error("--dim must be non-negative (0 for all dimensions).")
    if args.top < 0: parser.error("--top must be non-negative (0 disables displayed connectivity edges).")

    if args.transitions is not None and len(args.transitions) not in [0, 2]:
        parser.error("--transitions/--changes requires either 0 arguments (overview) or 2 cluster IDs (inspect a specific pair).")

    clustering_flags = ['--size', '--samples', '--auto', '--method', '--dim', '--rmsd', '--step', '--segid']
    is_full_pipeline = True

    if args.transitions is not None:
        passed_clustering_flags = [flag for flag in clustering_flags if flag in sys.argv]
        if not passed_clustering_flags:
            is_full_pipeline = False

    logging.basicConfig(level=logging.INFO, format='%(message)s', handlers=[logging.StreamHandler(sys.stdout)])
    logging.getLogger('matplotlib').setLevel(logging.WARNING)

    if is_full_pipeline:
        logging.info(f"{Colors.BOLD}=== clusterMD | HDBSCAN Analysis of Molecular-Dynamics PCA Coordinates ==={Colors.RESET}")
        logging.info(f"{Colors.LIGHT_BLUE}[*]{Colors.RESET} Locating fluctuations file...")
        
        fluctuation_files = glob.glob('*fluctuations.dat') or glob.glob('carma_results*/*fluctuations.dat') or glob.glob('../*fluctuations.dat') or glob.glob('../carma_results*/*fluctuations.dat')

        if not fluctuation_files:
            logging.error(f"{Colors.RED}[-]{Colors.RESET} Critical error: '*fluctuations.dat' not found in current directory, or any 'carma_results*' subdirectories/parent directories.")
            logging.error(f"{Colors.RED}[-]{Colors.RESET} Execution terminated before analysis.")
            sys.exit(1)

        if len(fluctuation_files) > 1:
            logging.warning(f"{Colors.YELLOW}[WARN]{Colors.RESET} Multiple fluctuation files found. Selecting the most recently modified.")
        data_file = max(fluctuation_files, key=os.path.getmtime)
        
        logging.info(f"{Colors.BLUE}[+]{Colors.RESET} Input file: {data_file}")

        target_analysis_dir = os.path.dirname(data_file)
        if not target_analysis_dir: target_analysis_dir = '.'
        logging.info(f"{Colors.LIGHT_BLUE}[*]{Colors.RESET} Analysis directory: {target_analysis_dir}")

        timestamp = datetime.datetime.now().strftime("%d.%m.%Y_%H.%M.%S.%f")[:-3]
        results_dir = f"clusterMD_results_{timestamp}"
        os.makedirs(results_dir, exist_ok=True)

        file_handler = logging.FileHandler(os.path.join(results_dir, "clustering_execution.log"))
        file_handler.name = "clusterMD_file"
        file_handler.setFormatter(PlainFileFormatter('%(message)s'))
        logging.getLogger().addHandler(file_handler)
        
        logging.info(f"Command line: {command_line}")
        logging.info(f"{Colors.LIGHT_BLUE}[*]{Colors.RESET} Output directory: {results_dir}")
        
        try:
            run_full_pipeline(args, data_file, results_dir, target_analysis_dir, command_line)
        except KeyboardInterrupt:
            logging.error(f"\n{Colors.RED}[-]{Colors.RESET} Process interrupted by user. Shutting down gracefully.")
            sys.exit(130)

    else:
        logging.info(f"{Colors.BOLD}=== clusterMD | Post-Run Observed-Change Inspection ==={Colors.RESET}")
        dat_files = glob.glob("hdbscan.*-D.clusters.dat")
        
        if not dat_files:
            logging.error(f"\n{Colors.RED}[-]{Colors.RESET} Critical error: 'hdbscan.*-D.clusters.dat' not found in the current directory.")
            logging.error(f"{Colors.YELLOW}[*]{Colors.RESET} You are running in diagnostic mode without full pipeline flags.")
            logging.error(f"{Colors.YELLOW}[*]{Colors.RESET} Please navigate INSIDE a 'clusterMD_results_*' folder to run this command.")
            sys.exit(1)
            
        if len(dat_files) > 1:
            logging.warning(f"{Colors.YELLOW}[WARN]{Colors.RESET} Multiple cluster dat files found. Selecting the most recently modified.")
        dat_file = max(dat_files, key=os.path.getmtime)
        
        logging.info(f"{Colors.LIGHT_BLUE}[*]{Colors.RESET} Target data located: {os.path.abspath(dat_file)}")
        try:
            run_diagnostic_validation(args, dat_file)
        except KeyboardInterrupt:
            logging.error(f"\n{Colors.RED}[-]{Colors.RESET} Diagnostic run interrupted by user.")
            sys.exit(130)